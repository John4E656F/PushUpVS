# HTTP
PORT=8080
ALLOWED_ORIGINS=*

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=pushup

# Clerk (dashboard.clerk.com → API keys / Webhooks)
CLERK_SECRET_KEY=your-clerk-secret-key
CLERK_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Backblaze B2 (S3-compatible API — Buckets → App Keys)
B2_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_KEY_ID=your-key-id
B2_APPLICATION_KEY=your-application-key
B2_BUCKET=pushup-media

# Trial length in days
TRIAL_DAYS=7
