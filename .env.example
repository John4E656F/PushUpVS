# Clerk (dashboard.clerk.com → API keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# Go API base URL (server/ — leave unset for local-only mode)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Clerk Billing hosted pricing/checkout page (opened in the browser)
EXPO_PUBLIC_BILLING_URL=

# Optional: self-hosted MoveNet model (defaults to Google's hosted TFLite;
# run scripts/download-model.sh to grab a copy you can serve yourself)
# EXPO_PUBLIC_MOVENET_MODEL_URL=
